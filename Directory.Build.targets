<Project>
  <!-- Central version pins: projects reference packages by id only. -->
  <ItemGroup>
    <PackageReference Update="Microsoft.Playwright" Version="1.59.0" />
    <PackageReference Update="Assimalign.Viu.Router" Version="$(ViuVersion)" />
    <PackageReference Update="Assimalign.Viu.Browser.Router" Version="$(ViuVersion)" />
    <PackageReference Update="Assimalign.Cohesion.Viu.Hosting" Version="$(CohesionViuVersion)" />
    <PackageReference Update="Assimalign.Cohesion.Viu.Hosting.Browser" Version="$(CohesionViuVersion)" />
    <PackageReference Update="Assimalign.Cohesion.Viu.Routing" Version="$(CohesionViuVersion)" />
    <PackageReference Update="Assimalign.Cohesion.Viu.Server" Version="$(CohesionViuVersion)" />
  </ItemGroup>
</Project>
