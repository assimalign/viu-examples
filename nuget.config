<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--
        Repo-local NuGet configuration. Project-SDK resolution reads this file before restore
        properties exist, so the global.json msbuild-sdks pins resolve through these same sources.

        - assimalign: the org GitHub Packages feed carrying Viu, Cohesion, and Cohesion.Viu CI builds
          (10.0.0-preview.0.ci.N) and releases. GitHub Packages requires a token with read:packages
          even for public packages. Never commit it; supply it from the environment:
            NuGetPackageSourceCredentials_assimalign=Username=<user>;Password=<token>
        - nuget.org: everything else.

        clear ensures user/machine-level <packageSources> don't influence the repo build.
    -->
    <packageSources>
        <clear />
        <add key="assimalign" value="https://nuget.pkg.github.com/assimalign/index.json" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
    <packageSourceMapping>
        <clear />
        <packageSource key="assimalign">
            <package pattern="Assimalign.Viu.*" />
            <package pattern="Assimalign.Cohesion.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
    <config>
        <!-- Keep CI-build extracts isolated from the machine-wide NuGet cache. -->
        <add key="globalPackagesFolder" value=".nuget/packages" />
    </config>
</configuration>
