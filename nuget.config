<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--
        Repo-local NuGet configuration.

        - viu-local: the sibling Viu repository feed. scripts/Install-Local.ps1
          supplies the SDK, App framework packs, and opt-in libraries such as
          Router. This keeps the showcase on the same external-consumer boundary
          as a published application: it consumes packages, never project references.

        - nuget.org: standard public feed for everything else (xunit, etc.).

        clear ensures user/machine-level <packageSources> don't influence the
        repo build.
    -->
    <packageSources>
        <clear />
        <add key="viu-local" value="../viu/_out/packages" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="viu-local">
            <package pattern="Assimalign.Viu.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
    <config>
        <!--
            Keep same-version local preview repacks isolated from the machine-wide
            NuGet cache. The directory is covered by the repo's packages ignore rule.
        -->
        <add key="globalPackagesFolder" value=".nuget/packages" />
    </config>
</configuration>
