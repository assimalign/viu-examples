<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!--
        Repo-local NuGet configuration.

        - cohesion-local: the in-tree feed populated by `dotnet pack` of the SDK
          and library projects. Lets the smoke-test consumer (and any other
          in-tree consumer) restore Assimalign.Cohesion.* packages from the
          repo build without needing a published feed.

        - nuget.org: standard public feed for everything else (xunit, etc.).

        clear ensures user/machine-level <packageSources> don't influence the
        repo build.
    -->
    <packageSources>
        <clear />
        <add key="local" value="C:\Source\repos\assimalign\viu\_out\packages" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="local">
            <package pattern="Assimalign.Viu.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
