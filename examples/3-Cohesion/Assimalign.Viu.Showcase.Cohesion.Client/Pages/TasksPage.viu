<!-- Async data through an injected service: load on mount, post on submit. -->
<template>
    <!-- Outside a Card slot and without @submit.prevent on purpose: see README "Known issues". -->
    <div class="task-form">
        <input v-model.trim="NewTitle" @keydown="OnKeyDownAsync" placeholder="Sent to POST /api/tasks" aria-label="Task title" />
        <button type="button" :disabled="!CanAdd" @click="AddAsync">Add task</button>
    </div>

    <Card title="Tasks from the server">
        <template #badge>
            <Pill :label="Status" />
        </template>

        <p v-if="IsLoading">Loading…</p>
        <p v-else-if="Error.Length > 0" class="error">{{ Error }}</p>
        <ul v-else class="task-list">
            <li v-for="task in Tasks" :key="task.Id">
                <span>{{ task.Title }}</span>
                <Pill :label="StatusLabel(task)" :tone="StatusTone(task)" />
            </li>
        </ul>

        <template #footer>
            <button type="button" @click="RefreshAsync">Refresh</button>
            · <a href="/report">See the same data rendered on the server ↗</a>
        </template>
    </Card>
</template>

@script {
    using System;
    using System.Collections.Generic;
    using System.Net.Http;
    using System.Threading;
    using System.Threading.Tasks;

    using Assimalign.Viu.Components;
    using Assimalign.Viu.Reactivity;
    using Assimalign.Viu.Showcase.Cohesion.Shared;

    private readonly Reference<IReadOnlyList<TaskSummary>> _tasks = Reactive.Reference<IReadOnlyList<TaskSummary>>([]);
    private readonly Reference<bool> _isLoading = Reactive.Reference(true);
    private readonly Reference<string> _error = Reactive.Reference(string.Empty);

    // The same ITaskCatalog contract the server-rendered report uses; here it is the HTTP client.
    private ITaskCatalog Catalog { get; set; } = null!;

    public IReadOnlyList<TaskSummary> Tasks => _tasks.Value;

    public bool IsLoading => _isLoading.Value;

    public string Error => _error.Value;

    public string Status => $"{Tasks.Count} tasks";

    // A native v-model target holds object? (the write-back is untyped); NewTitleText reads it typed.
    public Reference<object?> NewTitle { get; } = Reactive.Reference<object?>(string.Empty);

    public string NewTitleText => NewTitle.Value as string ?? string.Empty;

    public bool CanAdd => NewTitleText.Length > 0;

    partial void OnSetup()
    {
        Catalog = (ITaskCatalog?)Context!.Services?.GetService(typeof(ITaskCatalog))
            ?? throw new InvalidOperationException("ITaskCatalog is not registered.");

        // Mount does not wait for this task; the page shows "Loading…" until it completes.
        // The token is cancelled if the page unmounts first.
        OnMounted(LoadAsync);
    }

    private Task RefreshAsync() => LoadAsync(Context!.Lifecycle.CancellationToken);

    private async Task LoadAsync(CancellationToken cancellationToken)
    {
        _isLoading.Value = true;
        try
        {
            _tasks.Value = await Catalog.GetTasksAsync(cancellationToken);
            _error.Value = string.Empty;
        }
        catch (HttpRequestException exception)
        {
            _error.Value = $"Could not load tasks: {exception.Message}";
        }
        finally
        {
            _isLoading.Value = false;
        }
    }

    private async Task AddAsync()
    {
        string title = NewTitleText;
        if (title.Length == 0)
        {
            return;
        }

        NewTitle.Value = string.Empty;
        await Catalog.AddAsync(title, Context!.Lifecycle.CancellationToken);
        await LoadAsync(Context!.Lifecycle.CancellationToken);
    }

    // Task-returning handlers are awaited and observed by the runtime; async void is rejected.
    private Task OnKeyDownAsync(IElementEvent domEvent) =>
        domEvent.Key == "Enter" ? AddAsync() : Task.CompletedTask;

    private string StatusLabel(TaskSummary task) => task.IsDone ? "done" : "open";

    private string StatusTone(TaskSummary task) => task.IsDone ? "success" : "warning";
}

<style>
    .task-form {
        display: flex;
        gap: 0.5rem;
        padding: 1rem 1.25rem;
        border: 1px solid var(--viu-border);
        border-radius: 0.75rem;
        background: var(--viu-surface);
    }

    .task-form input {
        flex: 1;
        padding: 0.5rem 0.65rem;
        border: 1px solid var(--viu-border);
        border-radius: 0.5rem;
        font: inherit;
    }

    .task-list {
        display: grid;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .task-list li {
        display: flex;
        justify-content: space-between;
    }

    .error {
        color: #b91c1c;
    }
</style>
