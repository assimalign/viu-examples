<!-- Resolving application services from DI inside a component. -->
<template>
    <Card title="Dependency injection">
        <label class="field">
            <span>Your name</span>
            <input v-model="Name" placeholder="Ada" />
        </label>
        <!-- GreetingService was registered in Program.cs and resolved in OnSetup. -->
        <p>{{ Greeting }}</p>
        <template #footer>
            <Pill :label="EnvironmentLabel" tone="accent" />
        </template>
    </Card>

    <Card title="Library components work here too">
        <Counter :step="1" />
    </Card>
</template>

@script {
    using System;

    using Assimalign.Cohesion.Hosting;
    using Assimalign.Viu.Reactivity;
    using Assimalign.Viu.Showcase.Cohesion.Client.Services;

    private GreetingService Greeter { get; set; } = null!;

    public Reference<string> Name { get; } = Reactive.Reference(string.Empty);

    public string Greeting => Greeter.Greet(Name.Value);

    public string EnvironmentLabel { get; private set; } = string.Empty;

    partial void OnSetup()
    {
        Greeter = (GreetingService?)Context!.Services?.GetService(typeof(GreetingService))
            ?? throw new InvalidOperationException("GreetingService is not registered.");

        // Framework services share the container: the builder registers IHostEnvironment.
        IHostEnvironment? host = (IHostEnvironment?)Context!.Services?.GetService(typeof(IHostEnvironment));
        EnvironmentLabel = $"environment: {host?.Name ?? "unknown"}";
    }
}

<style>
    .field {
        display: grid;
        gap: 0.35rem;
        max-width: 20rem;
        font-weight: 600;
    }

    .field input {
        padding: 0.5rem 0.65rem;
        border: 1px solid var(--viu-border);
        border-radius: 0.5rem;
        font: inherit;
        font-weight: 400;
    }
</style>
