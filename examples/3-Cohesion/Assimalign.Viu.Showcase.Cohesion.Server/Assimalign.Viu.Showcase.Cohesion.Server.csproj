<Project Sdk="Assimalign.Cohesion.Sdk.Web">
  <!--
    The Cohesion Web host. It serves the WebAssembly client (static assets + SPA fallback), a small
    JSON API the client calls, and server-rendered Viu pages.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Assimalign.Viu.Showcase.Cohesion.Server</RootNamespace>
    <!-- Cohesion assemblies are marked [RequiresPreviewFeatures] (CA2252). -->
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <GenerateRequiresPreviewFeaturesAttribute>true</GenerateRequiresPreviewFeaturesAttribute>
    <!-- The referenced Viu component projects carry the targeting-only Assimalign.Viu.App
         framework reference, which a non-Viu host cannot resolve. The Viu runtime assemblies arrive
         as ordinary packages through Assimalign.Cohesion.Viu.Server instead. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Assimalign.Cohesion.Viu.Server" />
    <ProjectReference Include="..\Assimalign.Viu.Showcase.Cohesion.Shared\Assimalign.Viu.Showcase.Cohesion.Shared.csproj" />
    <!-- Builds the client first and records its output location (viu-client.json) beside this
         executable; publishing bundles the client's wwwroot. -->
    <ViuClientReference Include="..\Assimalign.Viu.Showcase.Cohesion.Client\Assimalign.Viu.Showcase.Cohesion.Client.csproj" />
  </ItemGroup>
</Project>
