<!-- A display-only progress bar. Shows numeric parameters, guards, and a computed inline style. -->
<template>
    <div class="progress" role="progressbar" :aria-valuenow="Value" aria-valuemin="0" :aria-valuemax="Maximum">
        <div class="progress__fill" :style="FillStyle"></div>
        <span class="progress__label">{{ LabelText }}</span>
    </div>
</template>

@script {
    using System;
    using System.Globalization;

    using Assimalign.Viu.Components;

    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public int Maximum { get; set; } = 100;

    // One interpolation on purpose: `{{ Value }} / {{ Maximum }}` crashes the ci.4 server-render
    // code generator (CompoundExpressionNode cast) when ViuServerRendering is on.
    public string LabelText => $"{Value} / {Maximum}";

    public string FillStyle
    {
        get
        {
            double ratio = Maximum <= 0 ? 0 : Math.Clamp((double)Value / Maximum, 0, 1);
            return string.Create(CultureInfo.InvariantCulture, $"width: {ratio * 100:0.#}%");
        }
    }
}

<style>
    .progress {
        position: relative;
        height: 1.5rem;
        border-radius: 0.5rem;
        background: var(--viu-surface-muted, #f1f5f9);
        overflow: hidden;
    }

    .progress__fill {
        height: 100%;
        background: var(--viu-accent, #4f46e5);
        transition: width 200ms ease;
    }

    .progress__label {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-size: 0.75rem;
        font-weight: 600;
        mix-blend-mode: difference;
        color: #ffffff;
    }
</style>
