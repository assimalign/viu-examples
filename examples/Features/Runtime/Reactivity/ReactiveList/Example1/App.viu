<template>
    <button @click="Add">Add</button>
    <ul>
        <li v-for="item in Items" :key="item">{{ item }}</li>
    </ul>
</template>
@script {
    using Assimalign.Viu.Reactivity;

    public ReactiveList<string> Items { get; } = new()
    {
        "first"
    };

    private void Add() => Items.Add($"item {Items.Count + 1}");
}
