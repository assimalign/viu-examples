<template>
    <button @click="Increment">{{ Count }} × 2 = {{ Doubled }}</button>
</template>
@script {
    using Assimalign.Viu.Reactivity;

    public Reference<int> Count { get; } = Reactive.Reference(0);

    private void Increment() => Count.Value++;
    public Computed<int> Doubled { get; private set; } = null!;

    partial void OnSetup() => Doubled = Reactive.Computed(() => Count.Value * 2);
}
