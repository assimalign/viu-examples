<template>
    <button @click="Increment">Add three</button>
    <output>{{ Count }}</output>
</template>
@script {
    using Assimalign.Viu.Reactivity;

    public Reference<int> Count { get; } = Reactive.Reference(0);

    private void Increment()
    {
        using (Reactive.Batch())
        {
            Count.Value++;
            Count.Value++;
            Count.Value++;
        }
    }
}
