@template {
    <div class="rating-control" role="radiogroup" :aria-label="Label">
        <button
            v-for="rating in RatingOptions"
            :key="rating"
            type="button"
            :class="ButtonClass(rating)"
            role="radio"
            :aria-checked="rating == SelectedRating"
            :aria-label="RatingLabel(rating)"
            @click="SelectRating(rating)">
            <span aria-hidden="true">★</span>
        </button>
        <span class="rating-control__summary">{{ SelectionSummary }}</span>
    </div>
}

@script {
    using System;
    using System.Collections.Generic;

    using Assimalign.Viu.Components;

    private static readonly IReadOnlyList<int> Options = [1, 2, 3, 4, 5];

    public IReadOnlyList<IComponentParameter> Parameters { get; } =
    [
        new ComponentParameter("modelValue", defaultFactory: static () => 3),
        new ComponentParameter("label", defaultFactory: static () => "Interactive rating"),
    ];

    public IReadOnlyList<IComponentEvent> Events { get; } =
    [
        new ComponentEvent(
            "update:modelValue",
            static arguments =>
                arguments.Count == 1
                && arguments[0] is int),
        new ComponentEvent(
            "changed",
            static arguments =>
                arguments.Count == 1
                && arguments[0] is int),
    ];

    public IReadOnlyList<int> RatingOptions => Options;

    public string Label =>
        Context.Arguments.Get<string>("label")
        ?? "Interactive rating";

    public int SelectedRating
    {
        get
        {
            object? value = Context.Arguments.Get<object?>("modelValue");
            return value switch
            {
                int rating => Math.Clamp(rating, 1, 5),
                long rating => Math.Clamp((int)rating, 1, 5),
                double rating => Math.Clamp((int)rating, 1, 5),
                _ => 3,
            };
        }
    }

    public string SelectionSummary => $"{SelectedRating} of 5";

    private string ButtonClass(int rating) =>
        rating <= SelectedRating
            ? "rating-control__button rating-control__button--selected"
            : "rating-control__button";

    private string RatingLabel(int rating) =>
        rating == 1
            ? "1 star"
            : $"{rating} stars";

    private void SelectRating(int rating)
    {
        Context.Emit("update:modelValue", rating);
        Context.Emit("changed", rating);
    }
}

@style scoped {
    .rating-control {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.42rem;
    }

    .rating-control__button {
        display: grid;
        width: 2.35rem;
        height: 2.35rem;
        padding: 0;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 0.72rem;
        color: var(--text-muted);
        background: var(--surface-muted);
        cursor: pointer;
        font-size: 1.08rem;
        transition:
            border-color 160ms ease,
            color 160ms ease,
            transform 160ms ease;
    }

    .rating-control__button:hover {
        border-color: color-mix(in srgb, var(--accent) 48%, var(--border));
        color: var(--accent);
        transform: translateY(-2px);
    }

    .rating-control__button--selected {
        border-color: color-mix(in srgb, #f4b942 58%, var(--border));
        color: #f4b942;
        background: color-mix(in srgb, #f4b942 12%, var(--surface));
    }

    .rating-control__button:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--accent) 28%, transparent);
        outline-offset: 2px;
    }

    .rating-control__summary {
        margin-left: 0.45rem;
        color: var(--text-muted);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.04em;
    }
}
