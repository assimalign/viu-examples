<template>
    <article class="feature-card">
        <header class="feature-card__header">
            <div>
                <slot name="eyebrow">
                    <span class="feature-card__eyebrow">{{ Eyebrow }}</span>
                </slot>
                <slot name="title">
                    <h2>{{ Title }}</h2>
                </slot>
            </div>
            <slot name="badge" />
        </header>
        <div class="feature-card__body">
            <slot>
                <p class="muted-copy">No content was supplied for this card.</p>
            </slot>
        </div>
        <footer v-if="HasFooter" class="feature-card__footer">
            <slot name="footer" />
        </footer>
    </article>
</template>

@script {
    using Assimalign.Viu.Components;

    [Parameter(IsRequired = true)]
    public string Title { get; set; } = string.Empty;

    [Parameter(IsRequired = true)]
    public string Eyebrow { get; set; } = string.Empty;

    public bool HasFooter => Context!.Bindings.Slots.ContainsKey("footer");
}

<style>
    .feature-card {
        display: grid;
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 1.35rem;
        background: var(--surface);
        box-shadow: var(--shadow-soft);
    }

    .feature-card__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.35rem 1.35rem 0;
    }

    .feature-card__eyebrow {
        color: var(--accent);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .feature-card__header h2 {
        margin: 0.35rem 0 0;
        color: var(--text-strong);
        font-size: 1.12rem;
        line-height: 1.3;
    }

    .feature-card__body {
        padding: 1.15rem 1.35rem 1.35rem;
    }

    .feature-card__footer {
        padding: 0.95rem 1.35rem;
        border-top: 1px solid var(--border);
        background: var(--surface-muted);
    }

    .feature-card .muted-copy {
        margin: 0;
        color: var(--text-muted);
    }
</style>
