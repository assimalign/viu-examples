<template>
    <section class="not-found-panel">
        <span class="not-found-code">404</span>
        <span class="section-kicker">Route not found</span>
        <h2>The Viu router matched the catch-all route.</h2>
        <p>
            No showcase view is registered for
            <code>/{{ RequestedPath }}</code>.
            The catch-all parameter arrived as a declared component argument.
        </p>
        <div class="not-found-actions m-5">
            <RouterLink to="/">
                Return to the overview
            </RouterLink>
        </div>
    </section>
</template>

@script {
    using System.Collections.Generic;

    using Assimalign.Viu.Components;

    public IReadOnlyList<IComponentParameter> Parameters { get; } =
    [
        new ComponentParameter(
            "pathMatch",
            defaultFactory: static () => "unknown"),
    ];

    public string RequestedPath =>
        Context.Arguments.Get<string>("pathMatch") ?? "unknown";
}

