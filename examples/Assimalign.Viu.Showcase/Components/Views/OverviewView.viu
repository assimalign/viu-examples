        line-height: 1.55;
    }

    .footer-note {
        color: var(--text-muted);
        font-size: 0.82rem;
    }

    @keyframes slow-spin {
        to {
            rotate: 360deg;
        }
    }

    @media (max-width: 900px) {
        .hero-panel {
            grid-template-columns: 1fr;
        }

        .hero-orbit {
            display: none;
        }

        .metric-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 620px) {
        .metric-grid,
        .capability-grid {
            grid-template-columns: 1fr;
