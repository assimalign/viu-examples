<Project Sdk="Assimalign.Viu.Sdk.Browser">
	<PropertyGroup>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ViuRunAotCompilation Condition="'$(ViuRunAotCompilation)' == ''">false</ViuRunAotCompilation>
	</PropertyGroup>

	<ItemGroup>
		<StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Assimalign.Viu.Router" />
		<PackageReference Include="Assimalign.Viu.Browser.Router" />
		<PackageReference Include="Assimalign.Viu.UtilityCss.Build" >
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ViuUtilityCss Include="Styles/Utilities.css" />
	</ItemGroup>
</Project>
