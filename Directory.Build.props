<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- This machine's installed SDKs lack prune-package data for .NETCoreApp 10.0
         (NETSDK1226); the flag keeps IDE builds working without a command-line property. -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <PropertyGroup>
    <!-- One pin per family, all restored from the assimalign GitHub Packages feed.
         global.json selects the project SDKs; the package versions below must be builds of the
         same train: Cohesion.Viu ci.7 (viu-platforms main) was built against Viu ci.4 and
         Cohesion ci.21, so move all three together. ViuVersion is read back from global.json so
         the SDK and every Viu package reference can never disagree. -->
    <_ViuExamplesGlobalJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)global.json'))</_ViuExamplesGlobalJson>
    <ViuVersion>$([System.Text.RegularExpressions.Regex]::Replace($(_ViuExamplesGlobalJson), '(?s)^.*"Assimalign\.Viu\.Sdk"\s*:\s*"([^"]+)".*$', '$1'))</ViuVersion>
    <CohesionViuVersion>10.0.0-preview.0.ci.7</CohesionViuVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ViuRunAotCompilation)' == 'true'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>
</Project>
